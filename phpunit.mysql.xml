<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap-mysql.php"
         cacheResult="false"
         colors="true"
         failOnEmptyTestSuite="true"
         failOnSkipped="true"
>
    <testsuites>
        <testsuite name="MySQL regressions">
            <file>tests/Feature/Auth/LoginTest.php</file>
            <file>tests/Feature/Roles/AdminRoleManagementTest.php</file>
            <file>tests/Feature/Roles/RolesAndPermissionsSeederTest.php</file>
            <file>tests/Feature/Users/AdminUserManagementTest.php</file>
            <file>tests/Feature/Users/ConcurrentUserDisableTest.php</file>
            <file>tests/Feature/Users/UserStatusServiceTest.php</file>
        </testsuite>
    </testsuites>

    <php>
        <server name="APP_ENV" value="testing"/>
        <server name="DB_CONNECTION" value="mysql"/>
        <server name="DB_URL" value=""/>

        <env name="APP_ENV" value="testing" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_URL" value="" force="true"/>
    </php>
</phpunit>
