APP_NAME=OMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
AUTH_PASSWORD_RESET_FRONTEND_URL=http://127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

AUTH_TIMEBOX_DURATION_MICROSECONDS=200000
AUTH_DEFAULT_TOKEN_NAME="OMS client"
SANCTUM_TOKEN_EXPIRATION_MINUTES=60

# Requests per minute. The API IP quota is shared across all API routes.
RATE_LIMIT_API_PER_IP=120
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_LOGIN_PER_EMAIL=5

# Additional quotas for public password recovery requests.
RATE_LIMIT_PASSWORD_LINK_PER_IP=10
RATE_LIMIT_PASSWORD_LINK_PER_EMAIL=3
RATE_LIMIT_PASSWORD_RESET_PER_IP=15
RATE_LIMIT_PASSWORD_RESET_PER_EMAIL=5

# Additional quota for each authenticated account changing its password.
RATE_LIMIT_PASSWORD_CHANGE_PER_ACCOUNT=6
RATE_LIMIT_PASSWORD_CHANGE_WINDOW_MINUTES=1

# Page sizes for the Admin user list.
PAGINATION_USERS_DEFAULT_PER_PAGE=25
PAGINATION_USERS_MAX_PER_PAGE=100

# Page sizes for the Admin role list.
PAGINATION_ROLES_DEFAULT_PER_PAGE=25
PAGINATION_ROLES_MAX_PER_PAGE=100

# Page sizes for the Admin audit lists.
PAGINATION_ACCESS_AUDIT_LOGS_DEFAULT_PER_PAGE=25
PAGINATION_ACCESS_AUDIT_LOGS_MAX_PER_PAGE=100
PAGINATION_OPERATIONAL_AUDIT_LOGS_DEFAULT_PER_PAGE=25
PAGINATION_OPERATIONAL_AUDIT_LOGS_MAX_PER_PAGE=100

# Page sizes for the customer list.
PAGINATION_CUSTOMERS_DEFAULT_PER_PAGE=25
PAGINATION_CUSTOMERS_MAX_PER_PAGE=100

PAGINATION_PRODUCTS_DEFAULT_PER_PAGE=25
PAGINATION_PRODUCTS_MAX_PER_PAGE=100

# Orders use one two-decimal business currency.
ORDERS_CURRENCY=USD
ORDERS_MAX_ITEMS=100
ORDERS_ITEM_SEARCH_CACHE_ENABLED=false
ORDERS_ITEM_SEARCH_CACHE_TTL_SECONDS=30
ORDERS_ITEM_SEARCH_CACHE_MAX_IDS=1000
ORDERS_MAX_NOTE_LENGTH=2000
ORDERS_SYSTEM_ACTIVITY_LIMIT=50
ORDERS_WRITE_ATTEMPTS=2
ORDERS_RETRY_AFTER_SECONDS=1
PAGINATION_ORDERS_DEFAULT_PER_PAGE=25
PAGINATION_ORDERS_MAX_PER_PAGE=100
PAGINATION_ORDER_ASSIGNEES_DEFAULT_PER_PAGE=25
PAGINATION_ORDER_ASSIGNEES_MAX_PER_PAGE=100

# Dashboard revenue ranges use local calendar days.
DASHBOARD_TIMEZONE=UTC
DASHBOARD_RECENT_ORDERS_LIMIT=10
DASHBOARD_REVENUE_DEFAULT_DAYS=30
DASHBOARD_REVENUE_MAX_DAYS=366

# Reports share the Dashboard timezone for default calendar dates.
REPORTS_DEFAULT_DAYS=30
REPORTS_MAX_DAYS=366
PAGINATION_REPORTS_DEFAULT_PER_PAGE=25
PAGINATION_REPORTS_MAX_PER_PAGE=100

CATALOG_WRITE_ATTEMPTS=2
CATALOG_WRITE_RETRY_AFTER_SECONDS=1

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=oms
DB_USERNAME=oms
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

ORDER_NOTIFICATIONS_QUEUE=notifications
ORDER_NOTIFICATIONS_RECOVERY_DELAY_SECONDS=60
ORDER_NOTIFICATIONS_RECOVERY_BATCH_SIZE=100
ORDER_NOTIFICATIONS_JOB_ATTEMPTS=3
ORDER_NOTIFICATIONS_JOB_BACKOFF_SECONDS=10
PAGINATION_NOTIFICATIONS_DEFAULT_PER_PAGE=25
PAGINATION_NOTIFICATIONS_MAX_PER_PAGE=100

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
